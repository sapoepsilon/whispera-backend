# /etc/whispera/whispera.env (0640 root:whispera). No secrets in this file:
# the APNs key lives in /etc/whispera/apns.p8 (0600 whispera), written by inject-secrets.sh.
WHISPERA_LISTEN=127.0.0.1:8080
WHISPERA_DATABASE_URL=sqlite:///var/lib/whispera/whispera.db
WHISPERA_TRUST_PROXY_HEADERS=true
# Clerk production instance (whispera.mansurov.dev). Bind on aud, not azp:
# "whispera" = session tokens from the "whispera" JWT template;
# G1diJHbzgz2OlEIh = ID tokens from the public PKCE OAuth app the iOS/macOS
# apps sign in with (aud = client id).
WHISPERA_OIDC_ISSUER=https://clerk.whispera.mansurov.dev
WHISPERA_OIDC_AUDIENCES=whispera,G1diJHbzgz2OlEIh
APNS_AUTH_KEY_P8_FILE=/etc/whispera/apns.p8
APNS_KEY_ID=__APNS_KEY_ID__
APNS_TEAM_ID=__APNS_TEAM_ID__
APNS_TOPIC=com.chatgenie.Whispera
# Real Apple delivery, routed per device apns_env: sandbox -> api.sandbox.push.apple.com
# (development-signed builds), production -> api.push.apple.com. Never set
# APNS_SANDBOX_URL / APNS_PRODUCTION_URL here: they point at whispera-apns-mock (dev/e2e only).
RUST_LOG=info
