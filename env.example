# Required
DATABASE_URL=postgresql://whispera:whispera@localhost:5432/whispera
JWT_SECRET=your-jwt-secret-change-me

# Optional — server
# PORT=3000
# HOST=0.0.0.0
# NODE_ENV=development

# Optional — platform LLM keys (fallback when user doesn't send BYOK header)
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# Optional — OpenAI Codex OAuth
# OPENAI_CLIENT_ID=
# OPENAI_REDIRECT_URI=http://localhost:3000/auth/oauth/openai/callback
# FRONTEND_URL=http://localhost:5173

# Optional — encryption key for OAuth token storage (32-byte hex)
# ENCRYPTION_KEY=

# Optional — Stripe billing
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# STRIPE_SUCCESS_URL=http://localhost:3000/billing/success
# STRIPE_CANCEL_URL=http://localhost:3000/billing/cancel
